{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://sessions",
  "title": "sessions",
  "type": "object",
  "required": [
    "_id",
    "tenantId",
    "sourceId",
    "title",
    "date",
    "status"
  ],
  "properties": {
    "_id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "org": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "transcribe",
        "index"
      ],
      "properties": {
        "transcribe": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "done",
            "failed"
          ]
        },
        "diarize": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "done",
            "failed"
          ]
        },
        "summarize": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "done",
            "failed"
          ]
        },
        "index": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "done",
            "failed"
          ]
        }
      }
    },
    "indexAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "generation",
        "sessionId",
        "sourceId",
        "turnDigest",
        "strict",
        "state",
        "phase",
        "startedAt",
        "turnCount"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "turnDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strict": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "running",
            "complete",
            "failed",
            "uncertain"
          ]
        },
        "phase": {
          "enum": [
            "preflight",
            "writing"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "turnCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "chunks",
            "claims",
            "preservedClaims",
            "treeRevision"
          ],
          "properties": {
            "page": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "chunks": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "minItems": 1
            },
            "claims": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "preservedClaims": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "treeRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "title": "SessionIndexAttempt",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "finishedAt",
              "manifest"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
