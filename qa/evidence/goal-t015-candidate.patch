diff --git a/scripts/training/plan.mjs b/scripts/training/plan.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/training/plan.mjs
@@ -0,0 +1,95 @@
+/** T-015: content-free, private grounded-claim dataset proposal. No permission is minted. */
+import { createHash } from 'node:crypto';
+export const trainingHash = value => createHash('sha256').update(value).digest('hex');
+const normalized = text => text.normalize('NFKC').toLowerCase().replace(/\s+/g, ' ').trim();
+export const trainingId = value => typeof value === 'string' && /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$/.test(value);
+const requireValue = (condition, message) => { if (!condition) throw new Error(message); };
+
+/** Only an in-memory row builder. Returning rows is restricted to the approved exporter. */
+export function groundedTrainingRows(generation, tenantId) {
+  const {source, session, turns, claims} = generation.documents;
+  requireValue(source.tenantId === tenantId && session.tenantId === tenantId, 'tenant mismatch');
+  requireValue(trainingId(source._id) && session.sourceId === source._id, 'source identity mismatch');
+  requireValue(source.hash === undefined || (typeof source.hash === 'string' && /^[a-f0-9]{64}$/.test(source.hash)), 'invalid source hash');
+  requireValue(source.consent?.given === true && source.consent.revoked !== true, 'capture permission absent or revoked');
+  requireValue(source.trainingUse?.allowed !== false && source.trainingUse?.revoked !== true, 'source owner prohibits training');
+  for (const permission of [source.consent, source.trainingUse]) if (permission?.expiresAt !== undefined)
+    requireValue(typeof permission.expiresAt === 'string' && Number.isFinite(Date.parse(permission.expiresAt)) &&
+      Date.parse(permission.expiresAt) > Date.now(), 'source permission expired or invalid');
+  const byId = new Map(turns.map(t => [t._id, t])), seen = new Set(), rows = [], excluded = [];
+  for (const claim of claims) {
+    requireValue(claim.tenantId === tenantId && trainingId(claim._id) && !seen.has(claim._id), 'claim identity mismatch');
+    seen.add(claim._id);
+    if (claim.status !== 'verified') { excluded.push({id: claim._id, reason: 'claim-not-verified'}); continue; }
+    requireValue(typeof claim.text === 'string' && claim.text.trim() && claim.evidence?.length, 'claim invalid');
+    const evidence = claim.evidence.map(e => {
+      const turn = byId.get(e.turnId);
+      requireValue(e.sessionId === session._id && turn?.tenantId === tenantId && turn.sessionId === session._id &&
+        trainingId(turn._id) && typeof turn.text === 'string' && turn.text.trim() && trainingId(turn.speakerRef) &&
+        !['unknown','unresolved','anonymous'].includes(turn.speakerRef.toLowerCase()) &&
+        Number.isFinite(turn.tStart) && turn.tStart >= 0 && Number.isFinite(turn.tEnd) && turn.tEnd >= turn.tStart, 'claim evidence invalid');
+      requireValue(e.quote === undefined || (typeof e.quote === 'string' && e.quote.trim() && turn.text.includes(e.quote)), 'claim quote invalid');
+      return {turnId: turn._id, sessionId: session._id, speakerRef: turn.speakerRef, tStart: turn.tStart, tEnd: turn.tEnd, text: turn.text};
+    });
+    rows.push({format: 'grounded-claim-v1', id: claim._id, tenantId, sourceId: source._id, sessionId: session._id,
+      input: evidence, output: {text: claim.text, evidence: claim.evidence}, provenance: source.synthetic === true || source._id.startsWith('synthetic')
+        ? 'synthetic-fixture-current-derived-verified-claim' : 'current-derived-verified-claim'});
+  }
+  return {rows, excluded};
+}
+
+/** A row is a grounded claim task, not invented counselling question/answer supervision. */
+export function buildTrainingPlan(generations, config, exclusions = []) {
+  requireValue(trainingId(config?.tenantId) && trainingId(config.seed), 'tenant and seed identifier required');
+  requireValue(Array.isArray(config.sessions) && config.sessions.length && new Set(config.sessions).size === config.sessions.length &&
+    config.sessions.every(trainingId), 'explicit unique sessions required');
+  requireValue(Array.isArray(config.relatedGroups ?? []) && (config.relatedGroups ?? []).every(g => Array.isArray(g) && g.length > 1 &&
+    g.every(s => config.sessions.includes(s))), 'invalid related groups');
+  const accepted = [], omitted = [...exclusions], rowsBySession = new Map();
+  for (const g of generations) {
+    const id = g.documents.session._id, {rows, excluded} = groundedTrainingRows(g, config.tenantId);
+    requireValue(config.sessions.includes(id) && !rowsBySession.has(id), 'session selection mismatch');
+    omitted.push(...excluded.map(e => ({sessionId: id, ...e})));
+    rowsBySession.set(id, rows);
+    if (!rows.length) {omitted.push({sessionId: id, reason: 'no-verified-claims'}); continue;}
+    accepted.push({sessionId: id, sourceId: g.documents.source._id, sourceHash: g.documents.source.hash ?? null,
+      synthetic: rows.some(r => r.provenance.startsWith('synthetic')),
+      hashes: g.hashes, claimsSeen: g.documents.claims.length, rows});
+  }
+  // Preserve excluded selected IDs as relation bridges; only accepted sessions emit rows/splits.
+  const parent = new Map(config.sessions.map(id => [id, id]));
+  const find = id => { let p = parent.get(id); while (p !== parent.get(p)) p = parent.get(p); return p; };
+  const union = (a, b) => {if (parent.has(a) && parent.has(b)) parent.set(find(b), find(a));};
+  for (const group of config.relatedGroups ?? []) for (const id of group.slice(1)) union(group[0], id);
+  const owners = new Map();
+  for (const s of accepted) {
+    const keys = [...new Set([`source-id:${s.sourceId}`, ...(s.sourceHash ? [`source:${s.sourceHash}`] : []),
+      ...s.rows.flatMap(r => [`claim:${trainingHash(normalized(r.output.text))}`, ...r.input.map(t => `turn:${trainingHash(normalized(t.text))}`)])])];
+    for (const key of keys) { if (owners.has(key)) union(s.sessionId, owners.get(key)); else owners.set(key, s.sessionId); }
+  }
+  const groups = new Map();
+  for (const s of accepted) {const root = find(s.sessionId); if (!groups.has(root)) groups.set(root, []); groups.get(root).push(s.sessionId);}
+  const units = [...groups.values()].map(ids => ids.sort()).sort((a,b) => trainingHash(`${config.seed}\0${a.join('\0')}`).localeCompare(trainingHash(`${config.seed}\0${b.join('\0')}`)));
+  const splits = {train: [], validation: [], evaluation: []};
+  // Three independent leakage groups are the minimum for three nonempty splits, not a quality threshold.
+  units.forEach((ids, i) => splits[i === 0 ? 'evaluation' : i === 1 ? 'validation' : 'train'].push(...ids));
+  const membership = accepted.sort((a,b) => a.sessionId.localeCompare(b.sessionId)).map(s => ({
+    sessionId: s.sessionId, sourceId: s.sourceId, sourceHash: s.sourceHash, synthetic: s.synthetic, hashes: s.hashes,
+    claimsSeen: s.claimsSeen, rows: s.rows.map(r => ({id: r.id, sha256: trainingHash(JSON.stringify(r)),
+      outputSha256: trainingHash(r.output.text), evidence: r.input.map(({text, ...t}) => ({...t, sha256: trainingHash(text)}))}))
+  }));
+  const totalRows = membership.reduce((n,s) => n+s.rows.length,0);
+  const proposal = {format: 'own-model-plan-v1', taskFormat: 'grounded-claim-v1', tenantId: config.tenantId,
+    status: totalRows ? 'awaiting-exact-export-approval' : 'blocked-no-current-eligible-examples',
+    config: {tenantId: config.tenantId, seed: config.seed, sessions: [...config.sessions].sort(), relatedGroups: config.relatedGroups ?? []},
+    transformation: 'identity-v1; verified claim with full cited turns; no generated questions, redaction or semantic gold assertion',
+    permissions: 'capture permission is checked; training/export permission requires exact Umesh canonical decision; preparation never authorizes use',
+    provenance: 'only current derivation proof accepted; legacy-unbound/stale rejected',
+    membership, exclusions: omitted.sort((a,b) => JSON.stringify(a).localeCompare(JSON.stringify(b))),
+    splitAlgorithm: 'connected-source-session-content-v2; related closure over all selected sessions, accepted-only membership; first hashed group evaluation, second validation, remaining train',
+    leakageGroups: units, splits, counts: {selectedSessions: config.sessions.length, acceptedSessions: accepted.length,
+      rows: totalRows, groups: units.length, train: splits.train.reduce((n,id) => n+rowsBySession.get(id).length,0),
+      validation: splits.validation.reduce((n,id) => n+rowsBySession.get(id).length,0), evaluation: splits.evaluation.reduce((n,id) => n+rowsBySession.get(id).length,0)},
+    splitReady: units.length >= 3, exported: false, trained: false, evaluated: false, promoted: false};
+  return {...proposal, fingerprint: trainingHash(JSON.stringify(proposal))};
+}
diff --git a/scripts/training/prepare.mjs b/scripts/training/prepare.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/training/prepare.mjs
@@ -0,0 +1,80 @@
+/** Metadata preparation: never emits corpus text, calls models or modifies source data. */
+import { readFileSync, realpathSync, existsSync, writeFileSync } from 'node:fs';
+import { resolve, join, relative, isAbsolute, dirname } from 'node:path';
+import { pathToFileURL, fileURLToPath } from 'node:url';
+import { assertDerivedArtifactsCurrent } from '../lib/transcript-provenance.mjs';
+import { buildTrainingPlan, groundedTrainingRows, trainingId, trainingHash } from './plan.mjs';
+import { assertPrivateTrainingPath, resolvePrivateTrainingPath } from './private-path.mjs';
+export const TRAINING_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../..');
+function exclusionReason(error) {
+  const reasons = {'foreign tenant':'source-unavailable-for-selected-tenant','capture permission absent or revoked':'capture-permission-absent-or-revoked',
+    'source owner prohibits training':'source-owner-training-prohibition','source permission expired or invalid':'source-permission-expired-or-invalid',
+    'source identity mismatch':'source-identity-invalid','session identity mismatch':'session-identity-invalid',
+    'claim identity mismatch':'claim-identity-invalid','claim evidence invalid':'claim-evidence-invalid','claim quote invalid':'claim-quote-invalid',
+    'claim invalid':'claim-invalid','tenant mismatch':'source-unavailable-for-selected-tenant','invalid source hash':'source-hash-invalid',
+    'input outside corpus root':'source-location-invalid','invalid derivation identity':'derivation-identity-invalid','invalid derived evidence':'derivation-evidence-invalid'};
+  if (reasons[error?.message]) return reasons[error.message];
+  if (error?.message?.startsWith('derived provenance absent;')) return 'derivation-proof-missing';
+  if (error?.message?.startsWith('derived provenance stale or mismatched;')) return 'derivation-proof-not-current';
+  if (error?.code === 'ENOENT') return 'source-files-missing';
+  return 'source-artifacts-invalid';
+}
+export function containedTrainingPath(base, path) {
+  assertPrivateTrainingPath(base);assertPrivateTrainingPath(path);
+  const actual = realpathSync(path), rel = relative(realpathSync(base), actual);
+  if (rel === '..' || rel.startsWith('../') || rel.startsWith('..\\') || isAbsolute(rel)) throw new Error('input outside corpus root');
+  return actual;
+}
+/** Exact buffers validated by provenance are reused; error messages never contain source text. */
+export function loadTrainingGenerations(root, config) {
+  if (!trainingId(config?.tenantId) || !Array.isArray(config.sessions) || !config.sessions.length ||
+    config.sessions.some(id => !trainingId(id)) || new Set(config.sessions).size !== config.sessions.length) throw new Error('invalid tenant or selected sessions');
+  const corpus = resolve(root, 'data/toc-migrated'), generations = [], exclusions = [];
+  for (const sessionId of [...config.sessions].sort()) {
+    const dir = join(corpus, sessionId);
+    try {
+      const actual = containedTrainingPath(corpus, dir);
+      // Check identity before loading detailed foreign-tenant rows or returning metadata.
+      const sourcePath = containedTrainingPath(actual, join(actual, 'source.json'));
+      const source = JSON.parse(readFileSync(sourcePath, 'utf8'));
+      if (source.tenantId !== config.tenantId) throw new Error('foreign tenant');
+      const snapshot = new Map();
+      const read = path => {const safe = containedTrainingPath(actual,path); if (!snapshot.has(safe)) snapshot.set(safe,readFileSync(safe)); return snapshot.get(safe);};
+      const g = assertDerivedArtifactsCurrent(actual, read);
+      g.hashes['derivation-provenance.json'] = trainingHash(read(join(actual,'derivation-provenance.json')));
+      if (g.documents.session._id !== sessionId) throw new Error('session identity mismatch');
+      groundedTrainingRows(g, config.tenantId);
+      generations.push(g);
+    } catch (error) {
+      // Do not disclose another tenant's IDs, text, timing or path through error details.
+      exclusions.push({sessionId, reason: exclusionReason(error)});
+    }
+  }
+  return {generations, exclusions};
+}
+export function prepareTrainingPlan(root, config) {
+  const {generations, exclusions} = loadTrainingGenerations(root, config);
+  return buildTrainingPlan(generations, config, exclusions);
+}
+export function trainingArguments(argv, required) {
+  const options = {};
+  if (argv.length !== required.length * 2) throw new Error('provide each required option exactly once');
+  for (let i=0; i<argv.length; i+=2) {
+    if (!required.includes(argv[i]) || options[argv[i]] || !argv[i+1] || argv[i+1].startsWith('--')) throw new Error('invalid option');
+    options[argv[i]] = argv[i+1];
+  }
+  if (required.some(k => !options[k])) throw new Error('missing option');
+  return options;
+}
+export function readTrainingJson(path) {return JSON.parse(readFileSync(resolvePrivateTrainingPath(path), 'utf8'));}
+export function writeTrainingMetadata(path, report) {
+  const out=resolvePrivateTrainingPath(path);
+  if (existsSync(out)) throw new Error('output exists');
+  writeFileSync(out, `${JSON.stringify(report, null, 2)}\n`, {flag: 'wx', mode: 0o600});
+}
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  try {const o = trainingArguments(process.argv.slice(2), ['--config', '--out']);
+    const p = prepareTrainingPlan(TRAINING_ROOT, readTrainingJson(o['--config'])); writeTrainingMetadata(o['--out'], p);
+    console.log(JSON.stringify({status:p.status, fingerprint:p.fingerprint, counts:p.counts, splitReady:p.splitReady}));
+  } catch {console.error('training preparation refused; check configuration and metadata output path'); process.exitCode=2;}
+}
diff --git a/scripts/training/validate.mjs b/scripts/training/validate.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/training/validate.mjs
@@ -0,0 +1,54 @@
+/** Source drift and canonical operator approval validation. No exports or provider calls. */
+import { readFileSync, realpathSync } from 'node:fs';
+import { resolve, relative, isAbsolute } from 'node:path';
+import { hostname } from 'node:os';
+import { pathToFileURL } from 'node:url';
+import { prepareTrainingPlan, trainingArguments, readTrainingJson, TRAINING_ROOT } from './prepare.mjs';
+import { trainingHash } from './plan.mjs';
+import { assertPrivateTrainingPath } from './private-path.mjs';
+const requireValue = (condition, message) => {if (!condition) throw new Error(message);};
+export function validateTrainingPlan(root, packet) {
+  requireValue(packet?.format === 'own-model-plan-v1', 'invalid plan format');
+  const current = prepareTrainingPlan(root, packet.config);
+  requireValue(JSON.stringify(packet) === JSON.stringify(current), 'training plan changed or stale');
+  return current;
+}
+/** The append-only canonical ledger is the trusted operator boundary, not caller approval JSON. */
+export function trainingApproval(root, decisionId, kind, expected, now = new Date()) {
+  requireValue(/^D-\d{3,}$/.test(decisionId) && ['Training-export', 'Training-run'].includes(kind), 'invalid decision selection');
+  const ledger = readFileSync(resolve(root, 'docs/DECISIONS.md'), 'utf8');
+  const sections = ledger.split(/(?=^## D-\d+)/m);
+  const matches = sections.filter(s => s.startsWith(`## ${decisionId} |`));
+  requireValue(matches.length === 1 && /status: ACTIVE\s*$/m.test(matches[0].split(/\r?\n/)[0]), 'active decision required');
+  requireValue(!sections.some(s => s.split(/\r?\n/).some(l => l.startsWith('**Supersedes:** ') &&
+    new RegExp(`(?:^|[^A-Za-z0-9-])${decisionId}(?![A-Za-z0-9-])`).test(l))), 'decision superseded');
+  const entry = matches[0];
+  requireValue(/^\*\*Approved-by:\*\* Umesh\s*$/m.test(entry), 'explicit Umesh approval required');
+  const lines = entry.split(/\r?\n/).filter(l => l.startsWith(`**${kind}:** `));
+  requireValue(lines.length === 1, 'exact structured approval required');
+  const grant = JSON.parse(lines[0].slice(`**${kind}:** `.length));
+  requireValue(grant.version === 1 && grant.revoked === false && grant.privacy === 'local-only', 'private current approval required');
+  for (const [key,value] of Object.entries(expected)) requireValue(JSON.stringify(grant[key]) === JSON.stringify(value), 'approval scope mismatch');
+  for (const k of ['approvedAt','expiresAt']) requireValue(typeof grant[k] === 'string' && new Date(grant[k]).toISOString() === grant[k], 'canonical validity dates required');
+  requireValue(Date.parse(grant.approvedAt) <= now.getTime() && now.getTime() < Date.parse(grant.expiresAt), 'approval not effective or expired');
+  requireValue(typeof grant.purpose === 'string' && grant.purpose.trim() && typeof grant.restrictions === 'string' && grant.restrictions.trim(), 'purpose and restrictions required');
+  assertPrivateTrainingPath(grant.destination);
+  const binding=grant.storageProof;
+  requireValue(typeof binding?.path==='string' && /^qa\/evidence\/[A-Za-z0-9_.-]+\.json$/.test(binding.path) &&
+    /^[a-f0-9]{64}$/.test(binding.sha256),'canonical approval must bind host-private-storage proof');
+  const proofPath=realpathSync(resolve(root,binding.path)), rel=relative(realpathSync(resolve(root,'qa/evidence')),proofPath);
+  requireValue(rel && rel!=='..' && !rel.startsWith('../') && !rel.startsWith('..\\') && !isAbsolute(rel),'storage proof outside trusted evidence');
+  const proofBytes=readFileSync(proofPath); requireValue(trainingHash(proofBytes)===binding.sha256,'storage proof changed');
+  const proof=JSON.parse(proofBytes);
+  requireValue(proof.format==='private-storage-proof-v1' && proof.kind==='fixed-private-local-volume' && proof.status==='verified' &&
+    proof.hostId===hostname() && proof.destination===grant.destination && proof.verifiedBy==='Umesh' &&
+    typeof proof.evidence==='string' && proof.evidence.trim(),'current host-private-storage verification required');
+  for(const k of ['verifiedAt','expiresAt']) requireValue(typeof proof[k]==='string' && new Date(proof[k]).toISOString()===proof[k],'canonical storage proof dates required');
+  requireValue(Date.parse(proof.verifiedAt)<=now.getTime() && now.getTime()<Date.parse(proof.expiresAt),'storage proof not effective or expired');
+  return grant;
+}
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  try {const o = trainingArguments(process.argv.slice(2), ['--plan']); const p = validateTrainingPlan(TRAINING_ROOT, readTrainingJson(o['--plan']));
+    console.log(JSON.stringify({status: p.status, fingerprint: p.fingerprint, splitReady:p.splitReady, counts:p.counts, approvalRequired:true}));
+  } catch {console.error('training plan validation refused'); process.exitCode=2;}
+}
diff --git a/scripts/training/export.mjs b/scripts/training/export.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/training/export.mjs
@@ -0,0 +1,86 @@
+/** Local-only guarded corpus export. Preparation and D-170 never authorize this action. */
+import { readFileSync, realpathSync, existsSync, mkdirSync, writeFileSync, renameSync, rmSync } from 'node:fs';
+import { resolve, dirname, basename, join, relative, isAbsolute } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { randomUUID } from 'node:crypto';
+import { loadTrainingGenerations, trainingArguments, readTrainingJson, TRAINING_ROOT } from './prepare.mjs';
+import { buildTrainingPlan, groundedTrainingRows, trainingHash } from './plan.mjs';
+import { validateTrainingPlan, trainingApproval } from './validate.mjs';
+import { assertPrivateTrainingPath } from './private-path.mjs';
+const requireValue = (condition, message) => {if (!condition) throw new Error(message);};
+export function newTrainingDestination(path) {
+  assertPrivateTrainingPath(path);
+  requireValue(isAbsolute(path), 'absolute local destination required');
+  const destination = join(realpathSync(dirname(path)), basename(path));
+  requireValue(resolve(path) === destination && !existsSync(destination), 'new canonical local destination required');
+  return destination;
+}
+export function trainingOutputOutsideCorpus(root, destination) {
+  for (const scope of ['data/toc-migrated','raw','sources','docs','contracts','qa/contracts','.git','.codex','.Codex','.agents']) {
+    const rel = relative(resolve(root,scope), destination);
+    requireValue(rel === '..' || rel.startsWith('../') || rel.startsWith('..\\') || isAbsolute(rel), 'destination overlaps protected input');
+  }
+}
+export function exportTrainingDataset(root, packet, {decisionId, destination, purpose}) {
+  const selected = validateTrainingPlan(root, packet);
+  requireValue(selected.splitReady && selected.counts.rows > 0, 'three independent nonempty splits required');
+  assertPrivateTrainingPath(destination);
+  const proposed=resolve(destination);
+  const grant = trainingApproval(root, decisionId, 'Training-export', {fingerprint:selected.fingerprint, tenantId:selected.tenantId,
+    destination:proposed, purpose, taskFormat:selected.taskFormat});
+  const out = newTrainingDestination(proposed); trainingOutputOutsideCorpus(root,out);
+  const {generations, exclusions} = loadTrainingGenerations(root, selected.config);
+  requireValue(JSON.stringify(buildTrainingPlan(generations, selected.config, exclusions)) === JSON.stringify(selected), 'source changed before export');
+  // All approval checks precede serialization and corpus writes. The same validated snapshots supply rows.
+  const rows = generations.flatMap(g => groundedTrainingRows(g, selected.tenantId).rows);
+  const tmp = `${out}.${randomUUID()}.partial`, files = {}; let created=false;
+  try {
+    requireValue(dirname(tmp)===dirname(out),'temporary output escaped approved parent');
+    mkdirSync(tmp, {mode:0o700}); created=true;
+    for (const [split, ids] of Object.entries(selected.splits)) {
+      const members = rows.filter(r => ids.includes(r.sessionId));
+      members.sort((a,b) => a.sessionId.localeCompare(b.sessionId) || a.id.localeCompare(b.id));
+      const body = members.map(r => JSON.stringify(r)).join('\n')+'\n';
+      writeFileSync(join(tmp,`${split}.jsonl`),body,{flag:'wx',mode:0o600});
+      files[split] = {file:`${split}.jsonl`,count:members.length,sha256:trainingHash(body)};
+    }
+    const receipt = {format:'own-model-export-v1',status:'exported',plan:selected,decisionId, destination:out,
+      purpose:grant.purpose, privacy:grant.privacy, restrictions:grant.restrictions, files,
+      trained:false,evaluated:false,promoted:false};
+    receipt.exportFingerprint = trainingHash(JSON.stringify(receipt));
+    writeFileSync(join(tmp,'export.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx',mode:0o600});
+    requireValue(!existsSync(out),'destination appeared during export');
+    renameSync(tmp,out); return receipt;
+  } finally {if(created)rmSync(tmp,{recursive:true,force:true});}
+}
+/** Actual training consumer checks exact bytes, membership/counts and a still-current approved snapshot. */
+export function validateTrainingExport(root, dir, now = new Date()) {
+  assertPrivateTrainingPath(dir);
+  const actual = realpathSync(dir), receipt = JSON.parse(readFileSync(join(actual,'export.json'),'utf8'));
+  const {exportFingerprint,...bound} = receipt;
+  requireValue(receipt.format === 'own-model-export-v1' && receipt.status === 'exported' && receipt.destination === actual &&
+    exportFingerprint === trainingHash(JSON.stringify(bound)), 'invalid export receipt');
+  const p = validateTrainingPlan(root,receipt.plan);
+  trainingApproval(root,receipt.decisionId,'Training-export',{fingerprint:p.fingerprint,tenantId:p.tenantId,destination:actual,
+    purpose:receipt.purpose,taskFormat:p.taskFormat},now);
+  const seen = new Set();
+  for (const split of ['train','validation','evaluation']) {
+    const expected = p.membership.filter(s => p.splits[split].includes(s.sessionId)).flatMap(s => s.rows.map(r => ({...r,sessionId:s.sessionId})));
+    const f = receipt.files?.[split];
+    requireValue(f?.file === `${split}.jsonl` && f.count === expected.length,'export split count invalid');
+    const path = realpathSync(join(actual,f.file)); requireValue(dirname(path) === actual,'dataset symlink escaped export');
+    const body = readFileSync(path,'utf8'); requireValue(trainingHash(body) === f.sha256,'dataset bytes changed');
+    const rows = body.trim().split('\n').map(l => JSON.parse(l)); requireValue(rows.length === expected.length,'dataset row count invalid');
+    for (const r of rows) {
+      const key = `${r.sessionId}\0${r.id}`, m = expected.find(e => e.id === r.id && e.sessionId === r.sessionId);
+      requireValue(r.tenantId === p.tenantId && m && m.sha256 === trainingHash(JSON.stringify(r)) && !seen.has(key),'dataset membership invalid'); seen.add(key);
+    }
+  }
+  return receipt;
+}
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
