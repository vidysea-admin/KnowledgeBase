{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://document_documents",
  "title": "document_documents",
  "type": "object",
  "required": [
    "_id",
    "tenantId",
    "sourceId",
    "version",
    "title",
    "format",
    "pages",
    "highlights",
    "createdAt"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "enum": [
        "pdf",
        "docx"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pageNumber",
          "text"
        ],
        "properties": {
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageNumber",
          "quote",
          "text",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "const": "unverified"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
