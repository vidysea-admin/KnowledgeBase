{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://decisions",
  "title": "decisions",
  "type": "object",
  "required": ["_id", "tenantId", "text", "status", "evidence"],
  "properties": {
    "_id": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "sourceEvidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationEvidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "type": "string", "enum": ["proposed", "verified", "needs-review"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["turnId", "sessionId"],
        "properties": {
          "turnId": { "type": "string" },
          "sessionId": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
