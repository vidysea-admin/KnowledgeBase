{
  "name": "living-knowledge-base",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "webinar:setup": "node scripts/webinar/setup.mjs",
    "webinar:run": "node scripts/webinar/run-pipeline.mjs",
    "webinar:record": "node --import tsx packages/meeting-bot/src/cli.ts record",
    "webinar:process": "node scripts/webinar/process-video.mjs",
    "webinar:sync": "node scripts/webinar/sync-session.mjs",
    "demo:live": "node scripts/demo/demo-live.mjs",
    "demo:up": "node scripts/demo/demo-live.mjs --up",
    "gen:types": "node scripts/gen-types.mjs",
    "audit:trackers": "node scripts/tracker-audit.mjs",
    "progress": "node scripts/catalogue-score.mjs",
    "verify:live": "node scripts/live-verify.mjs",
    "lint:structure": "node scripts/lint-loc.mjs --all",
    "lint:score": "node scripts/catalogue-score.mjs --check",
    "test": "pnpm -r test",
    "test:lint": "node --test scripts/lint.test.mjs scripts/snapshot.test.mjs scripts/catalogue.test.mjs scripts/catalogue-cli.test.mjs scripts/lib/tracker-audit.test.mjs scripts/lib/mutate.test.mjs scripts/lib/find-audio-file.test.mjs scripts/lib/eval-recall.test.mjs scripts/lib/lint-codex-hooks.test.mjs scripts/watch/lib/heartbeat.test.mjs scripts/webinar/session-rows.test.mjs scripts/webinar/start-record-detached.test.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "json-schema-to-typescript": "16.0.0",
    "migrate-mongo": "14.0.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "undici": "^8.10.1"
  }
}
