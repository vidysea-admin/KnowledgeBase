# live-verify runs: the reconcilable facts (preflight.json + summary.md) ARE committed; the
# bulk (page screenshots, raw response bodies) is regenerable by re-running
# `LKB_API_KEY=... pnpm verify:live`, which is the whole point of the protocol -- committing
# ~2MB of binaries per run would bloat the repo for evidence anyone can reproduce on demand.
qa/evidence/live-*/pages/
qa/evidence/live-*/api/

apps/api/src/routes/ghost.ts

# ISS-198. Dispatch markers (qa/dispatch/<slug>.json) are PER-SESSION EPHEMERA: they narrow
# "no verdict yet" into in-flight vs checker-died, and nothing more. The durable record of a
# check is the verdict file, which scripts/lib/dispatch-state.mjs treats as authoritative over
# any marker. Deliberately ignored rather than tracked: a committed marker outlives the check it
# describes and reads as in-flight for that slug and cycle until a matching verdict lands, and
# another session's `git add -A` on this shared tree would do exactly that. Same-tree visibility
# -- which is all the handshake needs -- works without tracking.
qa/dispatch/

# pnpm local store (created by offline install runs)
.pnpm-store/

# ephemeral chrome CDP profiles used for live-proof screenshots
qa/evidence/*/cdp-profile/

# meeting-bot: logged-in bot browser profile (cookies!) + webinar recordings
data/bot-profile/
data/browser/
# reingest snapshots hold transcript text + vectors; public remote, never commit (ISS-REINGESTSAFE-004)
data/reingest-snapshots/
.venv/
.cache/
.playwright-cli/
raw/webinars/
**/downloaded_files/

