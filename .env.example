# Environment variables read by the code. Copy to .env and fill in; never commit real values.
# Format per entry: what it is for -- required/optional -- default when unset (from the code).

# ===== API server (apps/api) =====
# TCP port for @lkb/api. Optional. Default 3300.
PORT=
# Comma-separated browser origins allowed by CORS. Optional, but without it apps/api allows zero
# cross-origin browser calls (default: empty list).
# apps/web's real dev origin -- include both localhost and 127.0.0.1 for local dev because browsers commonly open either.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Consent policy default (D-002). not read by current code (verify before removing)
CONSENT_POLICY_DEFAULT=

# ===== Database =====
# Mongo connection URL. Required for real use. Default when unset: mongodb://localhost:27017 (apps/api); scripts/workers have no default.
MONGODB_URL=
# Database name. REQUIRED for the API server (apps/api): no default, startup refuses when unset or empty (ISS-LEGACYSEED-009). Production sets it explicitly (docker-compose.yml pins `lkb`). lkb_staging additionally needs LKB_ALLOW_STAGING=lkb_staging. Work/recovery scripts require it to equal MONGO_WORK_DB when both are set.
# Also REQUIRED, with no default, by config/migrate-mongo-config.cjs and scripts/mint-key.mjs: `lkb` (production) is reachable there only with --i-know-this-is-production (migrate: or LKB_I_KNOW_THIS_IS_PRODUCTION=1) AND MONGODB_DB=lkb exactly (ISS-SCRIPTGUARDS-001, ISS-LEGACYSEED-002).
MONGODB_DB=
# Name of an isolated work database for seed/sync/recovery scripts and the meeting-candidate work path. Optional. No default (scripts refuse to run without it; "lkb" and "global_university_db" are refused).
MONGO_WORK_DB=
# Dedicated upload-queue database, must match upload_queue_<8-55 chars>. Required for the upload queue, transcribe worker and activity-health reader. No default.
UPLOAD_QUEUE_DB=
# Tenant id and actor for the upload queue. Required for the upload queue. No default.
UPLOAD_TENANT_ID=
UPLOAD_ACTOR=

# ===== AI providers =====
# Gemini API key (embeddings, STT, summaries; also the transcribe worker). Required for the Gemini provider. Default "" (provider unusable).
GEMINI_API_KEY=
# Override the Gemini speech-to-text model for long-session transcription. Optional. Default: the adapter's built-in model.
GEMINI_STT_MODEL=
# Claude: no key -- login via `claude` CLI OAuth (email -> OTP). ANTHROPIC_API_KEY is optional / off by default.
# not read by current code (verify before removing)
ANTHROPIC_API_KEY=
# not read by current code (verify before removing)
AI_ANTHROPIC_ENABLED=
# Base URL of the local Ollama server. Optional. Default: the OllamaProvider's built-in base URL.
OLLAMA_BASE_URL=
# Ollama model for the speaker-identity gate. Optional. Default "qwen3:8b" (the gate's frozen pin).
SPEAKERS_OLLAMA_MODEL=
# Vision model for webinar slide processing (scripts/webinar/process-video.mjs). Optional. No default (vision step is skipped unless set together with GEMINI_API_KEY).
WEBINAR_VISION_MODEL=
# --- Provider order for vision (ollamafirst) ---
# Live order lives in config/ai-routing.yaml: `vision: [ollama, gemini]` = Ollama Cloud first, Gemini as fallback. Edit that line to change it.
# Webinar slide text (screen OCR + T-041 keyframe alignment) is ON by default whenever a vision provider is configured (OLLAMA_API_KEY, or GEMINI_API_KEY + WEBINAR_VISION_MODEL); with none it is skipped with a logged reason. LKB_VISION_ROUTED=0 forces the old Gemini-only route; LKB_KEYFRAME_OCR=0 turns the keyframe stage off.
LKB_VISION_ROUTED=
LKB_KEYFRAME_OCR=
# Ollama Cloud key. With no OLLAMA_BASE_URL, vision uses https://ollama.com. Never commit a value.
OLLAMA_API_KEY=
# Comma list of vision-capable Ollama models, tried in order. Optional. Default: glm-5.3-flash,deepseek-v4.1-flash.
OLLAMA_VISION_MODELS=
# STT stays on Gemini: no Ollama Cloud model reports an audio capability (checked 2026-10-14). A Gemini 429 whose quotaId contains "FreeTier" raises GeminiFreeTierQuotaError: the key's project is not billed; use a key from a billed project.

# ===== Web fallback and search =====
# Optional integrations
# Tavily web search for the ask web fallback. Optional. No default (fallback reports "not configured").
TAVILY_API_KEY=
# Jina reader for URL ingest. Optional. No default (requests are sent without auth).
JINA_API_KEY=
# not read by current code (verify before removing)
FIRECRAWL_API_KEY=

# ===== Meeting bot and capture (packages/meeting-bot) =====
# Self-hosted Vexa meeting bot (T-024). not read by current code (verify before removing)
VEXA_BASE_URL=
# not read by current code (verify before removing)
VEXA_API_KEY=
# Capture backend: "tab" or "obs". Optional. Default "tab" (OBS is Windows-only).
LKB_CAPTURE_BACKEND=
# Tenant id for indexed captures and the calendar read. Required for `--index` captures (or pass --tenant). No default.
LKB_TENANT_ID=
# Schedule tick join-rules enforcement: "fail-closed" or "fail-open" enable it (Approver decision, T-037 W3); empty or anything else = off (today's behaviour).
LKB_JOIN_RULES_ENFORCE=
# ===== Autojoin (D-165): discovery, webinar auto-join, career priority, test-data routing, alerts =====
# Deployment defaults live in the committed, non-secret config/autojoin.json (all ON for this deployment). Each key can be overridden
# here with 1/true/on or 0/false/off; empty = use the file. No file and no variable = the schedule tick behaves as before autojoin.
# Switches: discovery (tick reads Calendar/Gmail), webinar auto-join (off = the tick only dry-runs), career guidance wins overlaps,
# non-career webinars tagged testData and routed to lkb_staging only.
LKB_AUTOJOIN_DISCOVERY=
LKB_AUTOJOIN_WEBINARS=
LKB_AUTOJOIN_CAREER_PRIORITY=
LKB_AUTOJOIN_TEST_DATA_ROUTING=
# Alert channels: email via the gws CLI, the web dashboard feed on /meeting-bot, and a private marker event on Umesh calendar via gws.
# LKB_ALERT_EMAIL_TO must be a plain address.
LKB_ALERT_EMAIL=
LKB_ALERT_DASHBOARD=
LKB_ALERT_CALENDAR=
LKB_ALERT_EMAIL_TO=
# Also email non-career (test data) webinars? Default off: they email only on failure. Max alert emails per rolling hour (failures bypass): default 6.
LKB_ALERT_EMAIL_TEST_DATA=
LKB_ALERT_EMAIL_PER_HOUR=
# Alternate paths for the autojoin config and the career keyword list (config/career-topics.json). Optional.
LKB_AUTOJOIN_CONFIG=
LKB_CAREER_TOPICS_FILE=
# Test data may be written only to lkb_staging, and only with this opt-in (D-143): LKB_ALLOW_STAGING=lkb_staging.

# Directory for the bot's browser profile. Optional. Default <repo>/data/bot-profile.
LKB_BOT_PROFILE_DIR=
# Browser profile sub-directory name (like --profile-directory). Optional. No default.
LKB_BROWSER_PROFILE_DIRECTORY=
# Browser executable for the tab backend (path, or a keyword the joiner understands). Optional. No default (joiner picks one).
LKB_BROWSER_EXECUTABLE=
# Python interpreter for the join script. Optional. Default "python".
LKB_PYTHON=
# Where recordings are written. Optional. Default <repo>/raw/webinars.
LKB_RECORD_DIR=
# OBS WebSocket endpoint and password (OBS backend only). URL optional, default ws://127.0.0.1:4455; password required for the OBS backend, no default.
OBS_WS_URL=
OBS_WS_PASSWORD=
# Explicit webinar registration form config, as JSON. Optional. No default (no config).
LKB_WEBINAR_REGISTRATION_CONFIG=
# Base URL and API key the scheduler uses to call apps/api. URL optional, default http://localhost:3300; key optional, no default.
LKB_API_URL=
LKB_API_KEY=
# Meeting-bot status alerts (T-030) -- joined/disconnected/recovered/finished to Umesh's phone.
# Missing either one disables alerts (one log line, recording still runs). Optional, no default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# U3 -- configurable notification channels (packages/meeting-bot/src/capture/notify/notify-channels.ts).
# Comma list from: telegram, whatsapp (stub -- logs "not configured", sends nothing until a real
# WhatsApp provider is wired). Missing/empty NOTIFY_CHANNELS defaults to "telegram" only (T-030's
# original single-channel behaviour, unchanged). The two per-class overrides win over the blanket
# NOTIFY_CHANNELS for that one event class ("digest" = the watcher digest U2 sends; "bot-status" =
# joined/disconnected/recovered/silence/finished above -- NOT wired to these envs yet, still
# Telegram-only via createTelegramNotifier, see that file's header). A future dashboard-settings
# override (U4) would take precedence over all three envs once a generic settings store exists --
# none does today (qa/contracts/web-settings-keys.md is API-key management only).
NOTIFY_CHANNELS=
NOTIFY_CHANNELS_DIGEST=
NOTIFY_CHANNELS_BOT_STATUS=

# ===== Calendar and Gmail =====
# Comma lists of sender emails / domains trusted for automatic webinar recording. Optional. Default: a built-in list in auto-record-policy.ts.
AUTO_RECORD_TRUSTED_EMAILS=
AUTO_RECORD_TRUSTED_DOMAINS=
# Gmail intake filters (comma lists of aliases / label ids). Optional. No default (no filtering).
LKB_GMAIL_ALIASES=
LKB_GMAIL_LABEL_IDS=
# Absolute path to the gws CLI for calendar attendance. Optional. Default <repo>/.cache/tools/gws-0.22.5/gws.exe.
LKB_GWS_PATH=
# Absolute path to ffprobe for calendar attendance. Optional. Default <repo>/.cache/tools/ffmpeg-9.0.2/bin/ffprobe.exe.
LKB_FFPROBE=

# ===== Watch service and upload scripts =====
# Heartbeat interval in ms for the watcher-silence detector. Optional. Default 3600000 (1 hour).
WATCH_HEARTBEAT_INTERVAL_MS=
# Comma list of tenant ids whose watchers are monitored. Optional. Default "toc".
WATCH_HEARTBEAT_TENANTS=
# Repo root used by scripts/watch. Optional. Default: two levels above scripts/watch.
LKB_MAIN_TREE_ROOT=
# Upload pipeline (scripts/upload, workers/transcribe). Directories must already exist.
# Input / output / spool roots: required by the upload submit step and worker. No default.
UPLOAD_INPUT_ROOT=
UPLOAD_OUTPUT_ROOT=
UPLOAD_SPOOL_ROOT=
# Python and ffprobe for the upload submit step. Optional. Defaults <repo>/.venv/Scripts/python.exe and <repo>/.cache/tools/ffmpeg-9.0.2/bin/ffprobe.exe.
UPLOAD_PYTHON=
UPLOAD_FFPROBE=
# Per-run timeout (ms) and max attempts. Optional. Defaults 1800000 and 2.
UPLOAD_TIMEOUT_MS=
UPLOAD_MAX_ATTEMPTS=
# Extra string mixed into the upload run id to force a fresh run. Optional. Default "".
UPLOAD_RUN_NONCE=

# ===== Telemetry =====
# "true" turns on AI call tracing. Optional. Default off.
TELEMETRY_ENABLED=

# ===== WhatsApp source (sources/whatsapp_msg) =====
# Mongo URL and database for WhatsApp messages. Optional. Defaults mongodb://127.0.0.1:27018 and "whatsapp_msg".
WHATSAPP_MONGO_URL=
WHATSAPP_MONGO_DB=
# Mapping of WhatsApp owner to tenant (parsed by createConfiguredWhatsAppOwnerResolver). Optional. No default (resolver gets undefined).
WHATSAPP_TENANT_OWNER_MAP=

# ===== apps/web (Vite) =====
# API base URL baked into the web build. Optional. Default: same-origin in production; localhost dev falls back to the API port.
VITE_API_BASE_URL=

# ===== Development tooling =====
# Python used by scripts/webinar/setup.mjs to create the venv. Optional. Default "python" on Windows, "python3" elsewhere.
LKB_SETUP_PYTHON=
# Wait (ms) for the QA ledger allocator lock. Optional. Default 8000.
LEDGER_LOCK_WAIT_MS=

# Optional: path to an AI-call trace file when TELEMETRY_ENABLED is true. Optional. No default.
TELEMETRY_TRACE_FILE=
# docker-compose only: host port for the web container. Optional. Default 8080.
WEB_PORT=

# Label review (D-183): directory for AI-consensus label reviews (T-022, U2.2). Absolute path outside the repo; /label-review answers 503 until set.
# LKB_LABEL_REVIEW_DIR=

# T-028 counsellor accounts (D-189): do NOT put these in .env. An empty or partial value makes the API answer
# auth routes 503. Put all five, with real values, in a separate file `.env.t028` (gitignored); compose reads
# it only if it exists. Names (all required together):
#   LKB_HOSTING_STATE_DIR=/var/lib/lkb/hosting      (the compose named volume; must differ from the next)
#   LKB_COUNSELLOR_STATE_DIR=/var/lib/lkb/counsellor
#   LKB_HOSTING_ENCRYPTION_KEY=                     (64 hex characters)
#   LKB_HOSTING_BOOTSTRAP_ADMINS=                   (JSON, single-quoted)
#   LKB_HOSTING_WEBHOOK_ORIGINS=                    (JSON array of https origins, single-quoted)
