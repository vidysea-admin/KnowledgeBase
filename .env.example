GEMINI_API_KEY=
MONGODB_URL=
MONGODB_DB=
# --- keys the design expects beyond the two above (fill when needed) ---
# Claude: no key — login via `claude` CLI OAuth (email -> OTP). ANTHROPIC_API_KEY is optional / off by default.
ANTHROPIC_API_KEY=
AI_ANTHROPIC_ENABLED=
# Self-hosted Vexa meeting bot (T-024)
VEXA_BASE_URL=
VEXA_API_KEY=
# Meeting-bot status alerts (T-030) -- joined/disconnected/recovered/finished to Umesh's phone.
# Missing either one disables alerts (one log line, recording still runs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# U3 -- configurable notification channels (packages/meeting-bot/src/capture/notify-channels.ts).
# Comma list from: telegram, whatsapp (stub -- logs "not configured", sends nothing until a real
# WhatsApp provider is wired). Missing/empty NOTIFY_CHANNELS defaults to "telegram" only (T-030's
# original single-channel behaviour, unchanged). The two per-class overrides win over the blanket
# NOTIFY_CHANNELS for that one event class ("digest" = the watcher digest U2 sends; "bot-status" =
# joined/disconnected/recovered/silence/finished above -- NOT wired to these envs yet, still
# Telegram-only via createTelegramNotifier, see that file's header). A future dashboard-settings
# override (U4) would take precedence over all three envs once a generic settings store exists --
# none does today (qa/contracts/web-settings-keys.md is API-key management only).
NOTIFY_CHANNELS=
NOTIFY_CHANNELS_DIGEST=
NOTIFY_CHANNELS_BOT_STATUS=
# Optional integrations
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
# Consent policy default (D-002)
CONSENT_POLICY_DEFAULT=
# apps/web's real dev origin -- without this, apps/api allows zero cross-origin browser calls
# Include both localhost and 127.0.0.1 for local dev because browsers commonly open either.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
