GEMINI_API_KEY=
MONGODB_URL=
MONGODB_DB=
# --- keys the design expects beyond the two above (fill when needed) ---
# Claude: no key — login via `claude` CLI OAuth (email -> OTP). ANTHROPIC_API_KEY is optional / off by default.
ANTHROPIC_API_KEY=
AI_ANTHROPIC_ENABLED=
# Self-hosted Vexa meeting bot (T-024)
VEXA_BASE_URL=
VEXA_API_KEY=
# Meeting-bot status alerts (T-030) -- joined/disconnected/recovered/finished to Umesh's phone.
# Missing either one disables alerts (one log line, recording still runs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional integrations
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
# Consent policy default (D-002)
CONSENT_POLICY_DEFAULT=
# apps/web's real dev origin -- without this, apps/api allows zero cross-origin browser calls
# Include both localhost and 127.0.0.1 for local dev because browsers commonly open either.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
