{
  "purpose": "Root-owned canonical schema integration request; maker never edits schema/generated/migrations.",
  "collections": {
    "gaps": {
      "property": "flywheel",
      "schema": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "originalEvalRunId", "inputFingerprint", "loss", "revision", "stage"],
        "properties": {
          "version": { "const": 1 }, "originalEvalRunId": { "type": "string", "minLength": 1 },
          "inputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "loss": {
            "type": "object", "additionalProperties": false,
            "required": ["question", "counsellor", "aiAnswer", "counsellorAnswer", "score", "credibility", "createdAt"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "counsellor": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "org": { "type": "string" } }, "additionalProperties": true },
              "aiAnswer": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 }, "sources": { "type": "object" } }, "additionalProperties": true },
              "counsellorAnswer": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
              "score": { "type": "object", "required": ["ai", "counsellor"], "properties": { "ai": { "type": "number" }, "counsellor": { "type": "number" }, "notes": { "type": "string" } }, "additionalProperties": true },
              "credibility": { "enum": ["internal", "independent-human", "calibrated-llm"] }, "createdAt": { "type": "string", "format": "date-time" }
            }
          },
          "revision": { "type": "integer", "minimum": 0 }, "stage": { "enum": ["awaiting-source", "captured", "indexed", "retested"] },
          "lock": { "type": "object", "additionalProperties": false, "required": ["token", "requestId", "expiresAt"], "properties": { "token": { "type": "string", "minLength": 1 }, "requestId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" }, "expiresAt": { "type": "string", "format": "date-time" } } },
          "sourceUrlFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "capture": { "$ref": "#/$defs/flywheelCapture" }, "index": { "$ref": "#/$defs/flywheelIndex" }, "lastRetestId": { "type": "string", "minLength": 1 },
          "failure": { "type": "object", "additionalProperties": false, "required": ["stage", "requestId", "at"], "properties": { "stage": { "enum": ["capture", "index", "retest", "persist"] }, "requestId": { "type": "string" }, "at": { "type": "string", "format": "date-time" } } },
          "failureHistory": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["stage", "requestId", "at"], "properties": { "stage": { "enum": ["capture", "index", "retest", "persist"] }, "requestId": { "type": "string" }, "at": { "type": "string", "format": "date-time" } } } }
        }
      }
    },
    "eval_runs": {
      "property": "flywheel",
      "schema": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "originalEvalRunId", "gapId", "inputFingerprint", "requestId", "index", "comparison"],
        "properties": {
          "version": { "const": 1 }, "originalEvalRunId": { "type": "string", "minLength": 1 }, "gapId": { "type": "string", "minLength": 1 },
          "inputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "requestId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
          "index": { "$ref": "#/$defs/flywheelIndex" }, "comparison": { "const": "needs-review" }
        }
      }
    }
  },
  "sharedDefs": {
    "flywheelCapture": {
      "type": "object", "required": ["sourceId", "sessionId", "sourceDigest", "transcriptDigest", "turnCount", "turnIds"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 }, "sourceDigest": { "type": "string", "minLength": 1 }, "transcriptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "turnCount": { "type": "integer", "minimum": 1 }, "turnIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }, "additionalProperties": false
    },
    "flywheelIndex": {
      "type": "object", "required": ["sourceId", "sessionId", "sourceDigest", "transcriptDigest", "turnCount", "turnIds", "generation", "treeDigest", "chunksDigest", "completedAt"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 }, "sourceDigest": { "type": "string", "minLength": 1 }, "transcriptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "turnCount": { "type": "integer", "minimum": 1 }, "turnIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "generation": { "type": "string", "minLength": 1 }, "treeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "chunksDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "completedAt": { "type": "string", "format": "date-time" }
      }, "additionalProperties": false
    }
  },
  "indexes": "No additional index: gap/retest identity embeds tenant via collision-free JSON tuple SHA256, Mongo _id uniqueness + scoped revision CAS provide natural keys. Existing tenant-first sourceRef indexes reused.",
  "databaseGuard": "createMongoFlywheelStore(db) refuses everything except /^lkb_t059_[a-z0-9_-]+$/i. This new seam has no approval to write lkb; production must remain unavailable until explicit approval.",
  "fixtures": "workflow.test.ts exact produced gap/retest fixture written to qa/evidence/goal-t059-maker/rows.json once focused tests receive root CPU lease; root can promote those records into schema fixtures."
}
